{%- comment -%}
  Section: Certification Highlight
  Left: editable image on a wavy colored panel
  Right: certificate badge image + title on one line, followed by body text
  All settings (images, text, colors) are editable from the Theme Editor.
  The two decorative shapes below are embedded directly in this file, exactly as provided.
{%- endcomment -%}

{%- capture deco_squiggle -%}data:image/png;base64,{%- endcapture -%}
{%- capture deco_splat -%}data:image/png;base64,{%- endcapture -%}

<div class="cert-highlight" id="cert-highlight-{{ section.id }}">
    <svg class="cert-highlight__wave" width="994" height="480" viewBox="0 0 994 480" preserveAspectRatio="none" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <path d="M969.241 232.405C1051.58 78.481 908.955 13.3333 827.352 0H0V480H969.241C934.935 461.603 886.906 386.329 969.241 232.405Z" fill="url(#paint0_radial_29_13)"/>
    <defs>
    <radialGradient id="paint0_radial_29_13" cx="0" cy="0" r="1" gradientUnits="userSpaceOnUse" gradientTransform="translate(497 233) rotate(90) scale(247 511.496)">
    <stop stop-color="#C3C2C7" stop-opacity="0"/>
    <stop offset="1" stop-color="#C3C2C7"/>
    </radialGradient>
    </defs>
    </svg>
  <div class="cert-highlight__inner">

    

    <div class="cert-highlight__left">
      {%- if section.settings.left_image != blank -%}
        <img
          class="cert-highlight__left-image"
          src="{{ section.settings.left_image | image_url: width: 1200 }}"
          alt="{{ section.settings.left_image.alt | escape }}"
          loading="lazy"
          width="{{ section.settings.left_image.width }}"
          height="{{ section.settings.left_image.height }}"
        >
      {%- else -%}
        <div class="cert-highlight__left-placeholder">
          {{ 'image' | placeholder_svg_tag: 'cert-highlight__placeholder-svg' }}
        </div>
      {%- endif -%}

      {%- if section.settings.show_decoration -%}
        <img class="cert-highlight__deco cert-highlight__deco--squiggle" src="{{ deco_squiggle }}" alt="" loading="lazy" width="103" height="105">
      {%- endif -%}
    </div>

    <div class="cert-highlight__right">
      <div class="cert-highlight__header">
        {%- if section.settings.badge_image != blank -%}
          <img
            class="cert-highlight__badge"
            src="{{ section.settings.badge_image | image_url: width: 200 }}"
            alt="{{ section.settings.badge_image.alt | escape }}"
            loading="lazy"
            width="{{ section.settings.badge_image.width }}"
            height="{{ section.settings.badge_image.height }}"
          >
        {%- endif -%}

        {%- if section.settings.title != blank -%}
          <h2 class="cert-highlight__title">{{ section.settings.title | escape }}</h2>
        {%- endif -%}
      </div>

      {%- if section.settings.text != blank -%}
        <div class="cert-highlight__text">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.settings.text_2 != blank -%}
        <div class="cert-highlight__text cert-highlight__text--secondary">{{ section.settings.text_2 }}</div>
      {%- endif -%}
      {%- if section.settings.show_decoration -%}
        <img class="cert-highlight__deco cert-highlight__deco--splat" src="{{ deco_splat }}" alt="" loading="lazy" width="90" height="110">

      {%- endif -%}
    </div>

  </div>
</div>

<style>
  #cert-highlight-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
    overflow: hidden;
    position: relative;
  }

  #cert-highlight-{{ section.id }} .cert-highlight__inner {
    position: relative;
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    align-items: stretch;
    min-height: 420px;
  }

  #cert-highlight-{{ section.id }} .cert-highlight__left {
    position: relative;
    z-index: 1;
    flex: 0 0 48%;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 360px;
    overflow: visible;
  }

  #cert-highlight-{{ section.id }} .cert-highlight__wave {
    position: absolute;
    inset: 0;
    width: 50%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }

  #cert-highlight-{{ section.id }} .cert-highlight__left-image,
  #cert-highlight-{{ section.id }} .cert-highlight__left-placeholder {
    position: relative;
    z-index: 1;
    max-width: 78%;
    max-height: 320px;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  #cert-highlight-{{ section.id }} .cert-highlight__left-placeholder svg {
    width: 100%;
    max-width: 320px;
    height: auto;
  }

  #cert-highlight-{{ section.id }} .cert-highlight__right {
    position: relative;
    z-index: 1;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 40px 60px;
  }

  #cert-highlight-{{ section.id }} .cert-highlight__header {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 18px;
  }

  #cert-highlight-{{ section.id }} .cert-highlight__badge {
    width: 67px;
    height: 90px;
    object-fit: contain;
    flex-shrink: 0;
  }

  #cert-highlight-{{ section.id }} .cert-highlight__title {
    font-size: 28px;
    line-height: 1.25;
    margin: 0;
    font-weight: 500;
  }

  #cert-highlight-{{ section.id }} .cert-highlight__text {
    font-size: 15px;
    line-height: 1.7;
    max-width: 520px;
    color: currentColor;
    opacity: 0.85;
  }

  #cert-highlight-{{ section.id }} .cert-highlight__text--secondary {
    margin-top: 18px;
  }

  #cert-highlight-{{ section.id }} .cert-highlight__deco {
    position: absolute;
    z-index: 2;
    pointer-events: none;
  }

  #cert-highlight-{{ section.id }} .cert-highlight__deco--splat {
    top: 4%;
    right: -2%;
    width: 60px;
    height: auto;
  }

  #cert-highlight-{{ section.id }} .cert-highlight__deco--squiggle {
    bottom: 6%;
    right: -4%;
    width: 68px;
    height: auto;
  }

  @media screen and (max-width: 749px) {
    #cert-highlight-{{ section.id }} .cert-highlight__inner {
      flex-direction: column;
      min-height: auto;
    }

    #cert-highlight-{{ section.id }} .cert-highlight__left {
      flex: none;
      min-height: 280px;
      padding: 30px 0;
    }

    #cert-highlight-{{ section.id }} .cert-highlight__right {
      padding: 30px 24px 40px;
      text-align: left;
    }

    #cert-highlight-{{ section.id }} .cert-highlight__title {
      font-size: 20px;
    }

    #cert-highlight-{{ section.id }} .cert-highlight__deco {
      display: none;
    }
    #cert-highlight-{{ section.id }} .cert-highlight__wave {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 50%;
      z-index: 0;
      pointer-events: none;
      transform: rotate(90deg);
      top: -90px;
      left: 0;
    }
  }
</style>

{% schema %}
{
  "name": "Certification Highlight",
  "tag": "section",
  "class": "section-certification-highlight",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background color",
      "default": "#E9EAF6"
    },
    {
      "type": "color",
      "id": "left_color",
      "label": "Left panel (wave) color",
      "default": "#D3D5E0"
    },
    {
      "type": "header",
      "content": "Left image"
    },
    {
      "type": "image_picker",
      "id": "left_image",
      "label": "Left image"
    },
    {
      "type": "header",
      "content": "Certification content"
    },
    {
      "type": "image_picker",
      "id": "badge_image",
      "label": "Certificate / badge image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "GREENGUARD Gold Certified"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Body text",
      "default": "<p>Relax and breathe easy knowing your nursery is GREENGUARD Gold Certified.</p>"
    },
    {
      "type": "richtext",
      "id": "text_2",
      "label": "Body text (second paragraph)",
      "default": "<p>Greenguard Gold Certified products guarantee safer furniture for babies and peace of mind for parents.</p>"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "show_decoration",
      "label": "Show decorative shapes",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top margin",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom margin",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Certification Highlight"
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
